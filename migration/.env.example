# Supabase (Settings → API). Только для локального ETL — не в Flutter / не в git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=insert_service_role_key_here

# Legacy read-only API (источник истории продаж)
OLD_API_URL=https://your-old-api.com/sales
OLD_API_KEY=insert_legacy_read_key_here
# Необязательно: Authorization (default) | X-API-Key | ...
OLD_API_KEY_HEADER=Authorization
OLD_API_KEY_PREFIX=Bearer

# Пагинация legacy API
OLD_API_PAGE_LIMIT=200

# Storage
SUPABASE_STORAGE_BUCKET=product-images
SUPABASE_STORAGE_PREFIX=sales_history

# WebP
WEBP_QUALITY=80

# HTTP
HTTP_TIMEOUT_SEC=60
IMAGE_MAX_BYTES=15728640

# Опционально: базовый URL CDN, если API не отдаёт image_url (путь как sync.js: product-images/{Articul}.webp)
# LEGACY_IMAGE_BASE_URL=https://iuezgsvihzhfnrdpdbzn.supabase.co/storage/v1/object/public

# 1 = только первая пачка (200 строк). 0 = полная миграция с checkpoint.
MIGRATION_PILOT=0
